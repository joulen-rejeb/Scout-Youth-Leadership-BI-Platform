# Use ONE of the following (Groq is used if a gsk_ key is present):

# Groq (key starts with gsk_) — https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Or Anthropic (key starts with sk-ant-) — https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional overrides:
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_PREFER_REQUESTS=1
#   ↑ use only if the default client fails to connect (Windows / proxy)
# Optional TLS (Windows / antivirus): npm run dev already uses node --use-system-ca.
# GROQ_SSL_STRICT=1  → verify Groq certs strictly (may fail behind HTTPS inspection)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
